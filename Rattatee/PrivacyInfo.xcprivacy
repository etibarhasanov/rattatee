<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The privacy manifest App Store review reads. It must match the
	     answers given under App Privacy in App Store Connect, which README.md
	     lists. Nothing tracks: no ads, no analytics, no third party.

	     Precise location: the points of a saved ride, sent to
	     tallinntastebuds.ee. Signed in, it is stored there under the account
	     (so "linked"), never shown with a name, and the first and last 200 m
	     are cut off before it is stored. With nobody signed in it is not
	     stored at all: the website counts the streets it went down and lets
	     it go, which is why the save card says the ride stays on the phone.
	     User ID: the account's username, which the site's session carries.

	     Two of Apple's required-reason APIs, each with the reason it is
	     used for. Anything new that reads a file's date, the disk's free
	     space, the time since boot or the keyboards is a line here, or App
	     Store Connect refuses the build (ITMS-91053).
	     UserDefaults (CA92.1, the app's own settings): the colour and the
	     background, the language, the voice, the radio and its station,
	     and the bike paths on the map.
	     File timestamps (C617.1, a file inside the app's own container):
	     Core/Venues.swift reads when its copy of the places, venues.json
	     in Application Support, was written, to ask for a new one once it
	     is a week old. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
